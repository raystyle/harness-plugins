{
  "name": "dev-fix",
  "version": "0.1.0",
  "description": "开发辅助 Hook:Windows Git Bash 编码/换行修复(chcp 65001 + PYTHONUTF8 + MSYS_NO_PATHCONV)+ Python venv 条件激活 + 写完文件自动 git add + 失败命令反斜杠路径提示",
  "author": {
    "name": "raystyle"
  },
  "license": "MIT",
  "homepage": "https://github.com/raystyle/harness-plugins/tree/main/plugins/dev-fix",
  "repository": "https://github.com/raystyle/harness-plugins",
  "keywords": ["windows", "git-bash", "encoding", "venv", "hook"],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/bash-fix.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-add.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/error-fix-hint.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
