{
  "name": "config",
  "version": "0.1.4",
  "description": "开发环境面合一插件:dev-fix(Windows Git Bash 编码/换行/MSYS 路径 hook + venv 条件激活 + 自动 git add + 失败命令路径提示)+ statusline(状态栏五行:模型/Context/MCP/LSP/Git/Cron)+ typescript-lsp(TS/JS)+ ty(Astral Python type checker)两个 LSP。原四插件归并于 config(2026-11-20)",
  "author": {
    "name": "raystyle"
  },
  "license": "MIT",
  "homepage": "https://github.com/raystyle/harness-plugins/tree/main/plugins/config",
  "repository": "https://github.com/raystyle/harness-plugins",
  "keywords": [
    "config",
    "hook",
    "statusline",
    "lsp",
    "typescript",
    "python"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/bash-fix.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/git-add.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/scripts/error-fix-hint.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": [
        "--stdio"
      ],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    },
    "python-lsp": {
      "command": "ty",
      "args": [
        "server"
      ],
      "transport": "stdio",
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python",
        ".pyw": "python"
      },
      "initializationOptions": {},
      "settings": {},
      "maxRestarts": 3
    }
  }
}
