{
  "name": "ty",
  "version": "0.1.0",
  "description": "ty:Astral 出的极速 Python type checker,LSP 形(.py/.pyi/.pyw)。需 PATH 有 ty(uv tool install ty / cargo install ty)",
  "author": {
    "name": "raystyle"
  },
  "license": "MIT",
  "homepage": "https://github.com/raystyle/harness-plugins/tree/main/plugins/ty",
  "repository": "https://github.com/raystyle/harness-plugins",
  "keywords": ["python", "lsp", "language-server", "type-checking", "ty", "astral"],
  "lspServers": {
    "python": {
      "command": "ty",
      "args": ["server"],
      "transport": "stdio",
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python",
        ".pyw": "python"
      },
      "initializationOptions": {},
      "settings": {},
      "maxRestarts": 3
    }
  }
}
