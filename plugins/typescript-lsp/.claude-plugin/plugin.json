{
  "name": "typescript-lsp",
  "version": "1.0.0",
  "description": "TypeScript/JavaScript language server:go-to-definition、find-references、编辑后错误检查(.ts/.tsx/.js/.jsx/.mts/.cts/.mjs/.cjs)。需 PATH 有 typescript-language-server(npm i -g typescript-language-server typescript)",
  "author": {
    "name": "raystyle"
  },
  "license": "MIT",
  "homepage": "https://github.com/raystyle/harness-plugins/tree/main/plugins/typescript-lsp",
  "repository": "https://github.com/raystyle/harness-plugins",
  "keywords": ["typescript", "javascript", "lsp", "language-server"],
  "lspServers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      }
    }
  }
}
